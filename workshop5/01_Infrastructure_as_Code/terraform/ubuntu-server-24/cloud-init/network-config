network:
  version: 2
  renderer: networkd
  ethernets:
    enp1s0:
      addresses:
        - ${ip}/${cidr}
      routes:
        - to: default
          via: ${gateway}
      nameservers:
          addresses: [${dns1}, ${dns2}]

