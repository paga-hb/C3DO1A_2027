FROM mcr.microsoft.com/dotnet/sdk:9.0
WORKDIR .
EXPOSE 80

COPY ./*.sln ./
COPY ./Flixtube.Metadata/ ./Flixtube.Metadata/
COPY ./Flixtube.Metadata.UnitTests/ ./Flixtube.Metadata.UnitTests/
COPY ./Flixtube.Metadata.IntegrationTests/ ./Flixtube.Metadata.IntegrationTests/

RUN ["dotnet","restore"]
CMD ["dotnet","watch","run","--no-launch-profile","--project","Flixtube.Metadata"]