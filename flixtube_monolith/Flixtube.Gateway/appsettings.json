{
  "Logging": {
    "LogLevel": {
      "Default": "Error",
      "Flixtube": "Trace",
      "Microsoft": "Error",
      "System": "Error"
    }
  },
  "AllowedHosts": "*",
  "Flixtube": {
    "FLIXTUBE_GATEWAY_PORT": "4010",
    "FLIXTUBE_STORAGE_FOLDER_NAME": "videos",
