    "FLIXTUBE_CONNECTION_STRING_SQLITE": "Data Source=flixtube.db",
    "FLIXTUBE_DATABASE_PROVIDER": "sqlite",
    "FLIXTUBE_SEED_DATABASE": "false"
  }
}